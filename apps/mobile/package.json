{
  "name": "@hyper-track/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "validate:config": "expo config --type public --json",
    "doctor": "npm run validate:config && expo install --check",
    "test": "tsx --test test/*.test.ts",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hyper-track/shared": "1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "expo": "~58.0.22",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3"
  }
}
