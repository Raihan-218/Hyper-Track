{
  "name": "hyper-track",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @hyper-track/api",
    "dev:mobile": "npm run start -w @hyper-track/mobile",
    "dev": "node scripts/dev.mjs",
    "android": "npm run android -w @hyper-track/mobile",
    "typecheck": "npm run typecheck -w @hyper-track/api && npm run typecheck -w @hyper-track/mobile",
    "test:api": "npm run test -w @hyper-track/api",
    "validate:expo": "npm run validate:config -w @hyper-track/mobile",
    "doctor": "npm run doctor -w @hyper-track/mobile",
    "export:web": "npm run export:web -w @hyper-track/mobile",
    "clean": "node scripts/clean.mjs"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
