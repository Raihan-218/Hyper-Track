# Reference only: copy the API section to apps/api/.env and the mobile section
# to apps/mobile/.env. These workspace files are what their services load.

# API (see apps/api/.env.example)
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/hyper-track
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:8081
XP_REWARD_TASK=10
XP_REWARD_HIGH_PRIORITY_TASK=15
XP_REWARD_HABIT=10
XP_REWARD_MILESTONE=50

# Mobile (see apps/mobile/.env.example)
    EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
